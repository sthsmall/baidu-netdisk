# 百度网盘 access_token（有效期 30 天，过期需重新授权）
#
# 获取方式：浏览器登录百度账号后打开下面链接并点击「授权」，
# 从跳转后的地址栏取 access_token= 到 & 之间的值。
# https://openapi.baidu.com/oauth/2.0/authorize?response_type=token&client_id=QHOuRXiepJBMjtk0esLhrPoNlQyYd0mF&redirect_uri=oob&scope=basic,netdisk
#
# 注意：请勿把真实 token 提交到仓库。

BAIDU_NETDISK_ACCESS_TOKEN=

# 可选：凭证文件路径（脚本默认读取 ~/.config/bdpan/access_token）
# BDPAN_TOKEN_FILE=
